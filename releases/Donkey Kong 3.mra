        <dip name="Lives" bits="8,9" ids="3,4,5,6"/>
        <dip name="Bonus Life" bits="10,11" ids="30000,40000,50000,None"/>
        <dip name="Additional Bonus" bits="12,13" ids="30000,40000,50000,None"/>
        <dip name="Difficulty" bits="14,15" ids="1,2,3,4"/>
    </switches>

