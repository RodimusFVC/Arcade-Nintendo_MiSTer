        <part crc="6ad59e40" name="sl.f1"/>
        <part crc="2de568e2" name="sl.f2"/>
        <part crc="06d0ab36" name="sl.g1"/>
        <part crc="73ac4fe6" name="sl.g2"/>
        <part crc="7f42a94b" name="sl.h1"/>
        <part crc="04b7a5f9" name="sl.h2"/>
        <part crc="d30007a3" name="sl.i1"/>
        <part crc="640ffd2f" name="sl.i2"/>
        <part repeat="0x6000">00</part>
        <part crc="8e1ff929" name="sl.snd"/>
        <part repeat="0x7C00">00</part>
        <part crc="c5914ec1" name="sf.prm"/>
    </rom>

    <!-- Index 1: board variant, flags, input map (see Arcade-Nintendo.sv) -->
