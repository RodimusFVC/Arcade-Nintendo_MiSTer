<misterromdescription>
    <name>Space Launcher</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Space Fever</series>
    <year>1979</year>
    <manufacturer>Nintendo</manufacturer>
    <category>Shooter</category>

    <setname>spacelnc</setname>
    <parent>spacelnc</parent>
    <mameversion>0289</mameversion>
    <rbf>Nintendo</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way</joystick>
    <special_controls></special_controls>
    <num_buttons>4</num_buttons>
    <buttons names="Fire,Game A,Game B,Game C,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="F0">
        <dip name="Lives" bits="0,1" ids="3,4,5,6"/>
        <dip name="Bonus Life" bits="2,3" ids="1000,3000,5000,8000"/>
        <dip name="Unused" bits="4" ids="Off,On" values="1,0"/>
        <dip name="Unused" bits="5" ids="Off,On" values="1,0"/>
        <dip name="Unused" bits="6" ids="Off,On" values="1,0"/>
        <dip name="Unused" bits="7" ids="Off,On" values="1,0"/>
    </switches>

    <!-- Index 0: MAME regions, layout in rtl/nintendo_board.sv -->
