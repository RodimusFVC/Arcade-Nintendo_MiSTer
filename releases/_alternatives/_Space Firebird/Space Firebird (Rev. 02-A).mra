<misterromdescription>
    <name>Space Firebird (Rev. 02-A)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Space Firebird</series>
    <year>1980</year>
    <manufacturer>Nintendo</manufacturer>
    <category>Shooter</category>

    <setname>spacefba</setname>
    <parent>spacefb</parent>
