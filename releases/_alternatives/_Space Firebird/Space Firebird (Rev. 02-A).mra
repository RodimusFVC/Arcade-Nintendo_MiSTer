    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Escape,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="20">
        <dip name="Lives" bits="0,1" ids="3,4,5,6"/>
        <dip name="Coinage" bits="2,3" ids="3C/1C,2C/1C,1C/1C,1C/2C" values="2,1,0,3"/>
        <dip name="Bonus Life" bits="4" ids="5000,8000"/>
        <dip name="Cabinet" bits="5" ids="Upright,Cocktail" values="1,0"/>
    </switches>

