<misterromdescription>
    <name>Space Bird (Bootleg)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Space Firebird</series>
    <year>1980</year>
    <manufacturer>bootleg (Karateco)</manufacturer>
    <category>Shooter</category>

    <setname>spacebrd</setname>
    <parent>spacefb</parent>
    <mameversion>0289</mameversion>
    <rbf>Nintendo</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Escape,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="20">
        <dip name="Lives" bits="0,1" ids="3,4,5,6"/>
        <dip name="Coinage" bits="2,3" ids="3C/1C,2C/1C,1C/1C,1C/2C" values="2,1,0,3"/>
        <dip name="Bonus Life" bits="4" ids="5000,8000"/>
        <dip name="Cabinet" bits="5" ids="Upright,Cocktail" values="1,0"/>
    </switches>

    <!-- Index 0: MAME regions, layout in rtl/nintendo_board.sv -->
    <rom index="0" md5="none" zip="spacebrd.zip|spacefb.zip">
        <part crc="232d66b8" name="sb5e.cpu"/>
        <part crc="99504327" name="sb5f.cpu"/>
        <part crc="49a26fe5" name="sb5h.cpu"/>
        <part crc="c23025da" name="sb5i.cpu"/>
        <part crc="5e97baf0" name="sb5j.cpu"/>
        <part crc="1713300c" name="5k.cpu"/>
        <part crc="4cbe92fc" name="sb5m.cpu"/>
        <part crc="1a798fbf" name="sb5n.cpu"/>
        <part repeat="0x4000">00</part>
        <part crc="1c8670b3" name="ic20.snd"/>
        <part repeat="0x3C00">00</part>
        <part crc="236e1ff7" name="5k.vid"/>
        <part crc="bf901a4e" name="6k.vid"/>
        <part repeat="0x3000">00</part>
        <part crc="528e8533" name="4i.vid"/>
        <part repeat="0x1F00">00</part>
        <part crc="25c79518" name="spcbird.clr"/>
    </rom>

    <!-- Index 1: board variant, flags, input map (see Arcade-Nintendo.sv) -->
    <rom index="1">
        <part>
            05 10 00 00 00 00 00 20 FF FF 80 80 80 00 80 80
            04 03 00 00 06 00 00 05 0C 0B 00 00 0E 00 00 0D
            00 00 13 14 00 00 16 11 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <remark>Space Bird (Bootleg) (Karateco Bootleg)</remark>
    <mratimestamp>20261017000000</mratimestamp>
</misterromdescription>
